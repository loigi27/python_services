# Para hospedagem Render: banco persistente e bucket privado no Supabase.
# No Supabase use a string do Session Pooler (IPv4), não a URL HTTP.
# DATABASE_URL=postgresql://postgres.PROJETO:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
# SUPABASE_URL=https://SEU-PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=CHAVE_SECRETA_DO_BACKEND_JAMAIS_DO_NAVEGADOR
# SUPABASE_STORAGE_BUCKET=devforge-private

# A primeira conta de admin é criada automaticamente ao iniciar.
# Remova BOOTSTRAP_ADMIN_PASSWORD das variáveis do Render DEPOIS de criar.
# BOOTSTRAP_ADMIN_NAME=Administrador
# BOOTSTRAP_ADMIN_EMAIL=loigi2704@gmail.com
# BOOTSTRAP_ADMIN_PASSWORD=SENHA_LONGA_COM_12_OU_MAIS_CARACTERES

